// filepath: c:\Users\otxw0\OneDrive\문서\univ project\backend\test\app.e2e-spec.ts
import { Test, TestingModule } from '@nestjs/testing';
import { INestApplication } from '@nestjs/common';
import * as request from 'supertest';
import { AppModule } from './../src/app.module';
import * as session from 'express-session';
import * as passport from 'passport';

// Utility function to join cookie array into a string
const joinCookies = (cookies: string[]): string => cookies.join('; ');

describe('AppController (e2e)', () => {
  let app: INestApplication;
  let authCookie: string[];
  let userId: string;

  beforeAll(async () => {
    const moduleFixture: TestingModule = await Test.createTestingModule({
      imports: [AppModule],
    }).compile();

    app = moduleFixture.createNestApplication();
    
    // 세션 설정이 필요합니다 (auth.controller.ts에서 세션을 사용하고 있습니다)
    app.use(
      session({
        secret: 'test-secret',
        resave: false,
        saveUninitialized: false,
      }),
    );
    app.use(passport.initialize());
    app.use(passport.session());
    
    await app.init();
  }, 30000); // 타임아웃 30초로 증가

  afterAll(async () => {
    if (app) {
      await app.close();
    }
  }, 30000); // 타임아웃 30초로 증가

  // Auth 모듈 테스트
  describe('Auth Module', () => {
    const testUser = {
      username: `test_${Date.now()}`,
      password: 'Password123!',
    };

    it('POST /users/register - 회원가입', async () => {
      const response = await request(app.getHttpServer())
        .post('/users/register')
        .send(testUser)
        .expect(201);
      
      expect(response.body).toBeDefined();
      expect(response.body.username).toBe(testUser.username);
      if (response.body._id) {
        userId = response.body._id;
      }
    });

    // 회원가입 후 로그인 시도
    it('POST /auth/login - 로그인', async () => {
      const response = await request(app.getHttpServer())
        .post('/auth/login')
        .send(testUser)
        .expect(201);
      
      expect(response.body.status).toBe('ok');
      expect(response.body.user).toBeDefined();
      // 쿠키 저장 (이후 인증이 필요한 요청에 사용)
      const cookieHeader = response.headers['set-cookie'];
      authCookie = Array.isArray(cookieHeader) ? cookieHeader : [cookieHeader];
      console.log('Auth cookie:', authCookie);
    });

    it('GET /auth/profile - 프로필 조회 (인증 상태)', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .get('/auth/profile')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(response.body.authenticated).toBe(true);
      expect(response.body.user).toBeDefined();
    });
  });

  // Users 모듈 테스트
  describe('Users Module', () => {
    const newUser = {
      username: `user_${Date.now()}`,
      password: 'Password123!',
    };

    it('POST /users/register - 사용자 등록', async () => {
      const response = await request(app.getHttpServer())
        .post('/users/register')
        .send(newUser)
        .expect(201);
      
      expect(response.body).toBeDefined();
      expect(response.body.username).toBe(newUser.username);
    });

    it('GET /users/me - 현재 로그인한 사용자 정보 조회', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .get('/users/me')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(response.body).toBeDefined();
      expect(response.body.username).toBeDefined();
    });
  });

  // SensorData 모듈 테스트
  describe('SensorData Module', () => {
    const sensorData = {
      x: 0.5,
      y: 1.2,
      z: -0.3,
      timestamp: new Date().toISOString(),
    };

    it('POST /sensor-data/raw - 센서 데이터 저장', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .post('/sensor-data/raw')
        .set('Cookie', joinCookies(authCookie))
        .send(sensorData)
        .expect(201);
      
      expect(response.body).toBeDefined();
      expect(response.body._id).toBeDefined();
    });

    it('GET /sensor-data/raw - 센서 데이터 조회', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .get('/sensor-data/raw?limit=5')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(Array.isArray(response.body)).toBe(true);
    });
  });

  // Analysis 모듈 테스트
  describe('Analysis Module', () => {
    it('POST /analysis - 분석 실행', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .post('/analysis')
        .set('Cookie', joinCookies(authCookie))
        .expect(201);
      
      expect(response.body).toBeDefined();
    });
  });

  // ML Result 모듈 테스트
  describe('MlResult Module', () => {
    const mlResult = {
      result: 'normal',
      confidence: 0.85,
      timestamp: new Date().toISOString(),
    };

    it('POST /ml-results - ML 결과 생성', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .post('/ml-results')
        .set('Cookie', joinCookies(authCookie))
        .send(mlResult)
        .expect(201);
      
      expect(response.body).toBeDefined();
      expect(response.body._id).toBeDefined();
    });

    it('GET /ml-results - ML 결과 조회', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .get('/ml-results')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(Array.isArray(response.body)).toBe(true);
    });
  });

  // Report 모듈 테스트
  describe('Report Module', () => {
    it('GET /report - 리포트 생성', async () => {
      expect(authCookie).toBeDefined();
      
      await request(app.getHttpServer())
        .get('/report')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
    });
  });

  // 로그아웃은 마지막에 테스트
  describe('Logout', () => {
    it('POST /auth/logout - 로그아웃', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .post('/auth/logout')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(response.body.status).toBe('logged out');
    });

    it('GET /auth/profile - 로그아웃 후 프로필 접근 시도', async () => {
      expect(authCookie).toBeDefined();
      
      const response = await request(app.getHttpServer())
        .get('/auth/profile')
        .set('Cookie', joinCookies(authCookie))
        .expect(200);
      
      expect(response.body.authenticated).toBe(false);
    });
  });
});
