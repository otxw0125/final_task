<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>홈페이지</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <!-- 로그인 페이지로 이동하는 버튼 -->
    <button onclick="window.location.href='/login'">로그인 화면 이동</button>
  </header>
  <h1>환영합니다!</h1>
  <p>기본 홈페이지 내용...</p>
  <button onclick="window.location.href='/monitoring'">각도 확인</button>
  
  <!-- 시리얼 포트를 수동 오픈하는 버튼 -->
  <button id="openPortBtn">시리얼 포트 오픈</button>

  <script>
    document.getElementById("openPortBtn").addEventListener("click", () => {
      fetch('/api/openPort', {
        method: 'POST'
      })
      .then(response => response.json())
      .then(data => {
        alert(data.message || '시리얼 포트 오픈 요청이 완료되었습니다.');
      })
      .catch(err => {
        console.error('시리얼 포트 오픈 오류:', err);
        alert('시리얼 포트를 열지 못했습니다.');
      });
    });
  </script>
</body>
</html>
