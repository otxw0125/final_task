<!DOCTYPE html>
<html>
<head>
  <title>Monitoring</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }
    h1 {
      color: #333;
    }
    ul {
      list-style-type: none;
      padding: 0;
    }
    li {
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <h1>최신 각도 값 모니터링</h1>
  <ul>
    <% if (latestAngleValues && latestAngleValues.length > 0) { %>
      <% latestAngleValues.forEach(function(value, index) { %>
        <li><%= index + 1 %>. <%= value %></li>
      <% }); %>
    <% } else { %>
      <li>데이터가 없습니다.</li>
    <% } %>
  </ul>
</body>
</html>
