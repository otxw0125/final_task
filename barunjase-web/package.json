{
  "name": "barunjase-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "seed": "cross-env NODE_ENV=development node --import dotenv/config  --import tsx/esm  scripts/seed-dev-data.ts",
    "test-env": "node --import tsx/esm scripts/test-env.ts",
    "process-status": "cross-env NODE_ENV=development node --import tsx/esm workers/dataProcessor.ts --status",
    "process-data": "cross-env NODE_ENV=development node --import tsx/esm workers/dataProcessor.ts",
    "process-batch": "cross-env NODE_ENV=development node --import tsx/esm workers/dataProcessor.ts --batch-size 50 --detailed-logging",
    "process-reprocess": "cross-env NODE_ENV=development node --import tsx/esm workers/dataProcessor.ts --reprocess"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.7",
    "chart.js": "^4.4.0",
    "mongodb": "^6.3.0",
    "next": "^14.2.29",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "recharts": "^2.15.3",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/recharts": "^1.8.29",
    "@types/testing-library__jest-dom": "^5.14.9",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.3.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
